# Copy to .env. Never commit .env.
# One provider key is enough. Standard provider names; Spriggs picks the client from the model prefix.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# provider/model, e.g. anthropic/claude-sonnet-5-5 or openrouter/<vendor>/<model>
SPRIGGS_MODEL=

# Git identity for commits made inside the container
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
