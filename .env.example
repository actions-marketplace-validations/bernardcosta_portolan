# Copy to .env. Never commit .env.
# One provider key is enough. Standard provider names; Spriggs picks the client from the model prefix.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# provider/model. Default when only ANTHROPIC_API_KEY is set: anthropic/claude-opus-5-5
# Examples: anthropic/claude-opus-5-5, openai/<model>, openrouter/<vendor>/<model>
SPRIGGS_MODEL=
